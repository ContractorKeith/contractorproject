{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "vite.performance.config.ts", "playwright.config.ts", "playwright.performance.config.ts", "tests/browser/*.pw.ts", "tests/browser/*.perf.ts"]
}
